<% content_for(:header_title, "Xabarlar - #{@other_user.first_name.present? ? "#{@other_user.first_name} #{@other_user.last_name}" : @other_user.email.split('@').first}") %>

<div class="max-w-6xl mx-auto h-[calc(100vh-180px)]">
  <div class="bg-white rounded-xl shadow-sm overflow-hidden h-full flex flex-col">
    <!-- Header -->
    <div class="p-4 border-b border-gray-200 flex items-center gap-4">
      <%= link_to conversations_path, class: "p-2 hover:bg-gray-100 rounded-lg transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-600">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      <% end %>
      
      <div class="flex items-center gap-3 flex-1">
        <div class="relative">
          <% if @other_user.avatar.attached? %>
            <%= image_tag @other_user.avatar, class: "w-12 h-12 rounded-full object-cover" %>
          <% else %>
            <div class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold">
              <%= (@other_user.first_name.present? ? @other_user.first_name.first : @other_user.email).first(1).upcase %>
            </div>
          <% end %>
          <span class="w-3 h-3 bg-green-500 rounded-full border-2 border-white absolute bottom-0 right-0"></span>
        </div>
        <div>
          <h1 class="font-semibold text-gray-800">
            <%= @other_user.first_name.present? ? "#{@other_user.first_name} #{@other_user.last_name}" : @other_user.email.split('@').first %>
          </h1>
          <p class="text-sm text-green-500">Online</p>
        </div>
      </div>

      <%= link_to profile_path(id: @other_user.id), class: "p-2 hover:bg-gray-100 rounded-lg transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-600">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
      <% end %>
    </div>

    <!-- Messages -->
    <div id="messages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-gray-50" data-conversation-id="<%= @conversation.id %>">
      <% if @direct_messages.any? %>
        <% @direct_messages.each do |message| %>
          <div class="flex <%= message.user_id == current_user.id ? 'justify-end' : 'justify-start' %>" data-message-id="<%= message.id %>">
            <div class="max-w-md <%= message.user_id == current_user.id ? 'bg-blue-600 text-white' : 'bg-white text-gray-800' %> rounded-2xl px-4 py-3 shadow-sm">
              <p class="text-sm"><%= message.content %></p>
              <span class="text-xs <%= message.user_id == current_user.id ? 'text-blue-100' : 'text-gray-400' %> block mt-1 text-right">
                <%= l(message.created_at, format: :short) %>
              </span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div id="no_messages" class="flex items-center justify-center h-full">
          <div class="text-center text-gray-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto text-gray-300 mb-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
            <p>Hali xabar yo'q</p>
            <p class="text-sm text-gray-400 mt-1">Birinchi xabarni yuboring!</p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Message Form -->
    <div class="p-4 border-t border-gray-200 bg-white">
      <%= form_with model: [@conversation, @conversation.direct_messages.build], 
          local: true,
          html: { id: "new_message_form", class: "flex gap-3" } do |f| %>
        <%= f.text_field :content, 
            placeholder: "Xabar yozing...", 
            class: "flex-1 rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
            id: "message_input",
            autocomplete: "off",
            required: true %>
        <%= f.submit "Yuborish", 
            class: "bg-blue-600 text-white px-6 py-3 rounded-xl hover:bg-blue-700 transition font-medium cursor-pointer flex items-center gap-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    const messagesContainer = document.getElementById('messages');
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  });
</script>
