<% content_for(:header_title, "Xabarlar") %>

<div class="max-w-6xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <div class="flex">
      <!-- Conversations List -->
      <div class="w-80 border-r border-gray-200 max-h-[calc(100vh-240px)] overflow-y-auto">
        <div class="p-4 border-b border-gray-200 sticky top-0 bg-white z-10">
          <h2 class="text-sm font-semibold text-gray-500 uppercase">Suhbatlar</h2>
        </div>

        <% if @conversations.any? %>
          <% @conversations.each do |conversation| %>
            <% other_user = conversation.other_user(current_user) %>
            <%= link_to conversation_path(conversation), class: "flex items-center gap-3 p-4 hover:bg-gray-50 border-b border-gray-100 transition" do %>
              <div class="relative flex-shrink-0">
                <% if other_user.avatar.attached? %>
                  <%= image_tag other_user.avatar, class: "w-12 h-12 rounded-full object-cover" %>
                <% else %>
                  <div class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold">
                    <%= (other_user.first_name.present? ? other_user.first_name.first : other_user.email).first(1).upcase %>
                  </div>
                <% end %>
                <span class="w-3 h-3 bg-green-500 rounded-full border-2 border-white absolute bottom-0 right-0"></span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center">
                  <span class="font-semibold text-gray-800 truncate">
                    <%= other_user.first_name.present? ? "#{other_user.first_name} #{other_user.last_name}" : other_user.email.split('@').first %>
                  </span>
                  <% if conversation.last_message %>
                    <span class="text-xs text-gray-400"><%= time_ago_in_words(conversation.last_message.created_at) %> oldin</span>
                  <% end %>
                </div>
                <% if conversation.last_message %>
                  <p class="text-sm text-gray-500 truncate"><%= conversation.last_message.content %></p>
                <% else %>
                  <p class="text-sm text-gray-400 italic">Xabar yo'q</p>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="p-8 text-center text-gray-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 mx-auto text-gray-300 mb-3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <p>Hali suhbat yo'q</p>
            <p class="text-sm text-gray-400 mt-1">Pastdan foydalanuvchi tanlang</p>
          </div>
        <% end %>
      </div>

      <!-- Users List -->
      <div class="flex-1 max-h-[calc(100vh-240px)] overflow-y-auto">
        <div class="p-4 border-b border-gray-200 sticky top-0 bg-white z-10">
          <h2 class="text-sm font-semibold text-gray-500 uppercase">Foydalanuvchilar</h2>
        </div>

        <div class="p-4">
          <% if @users.any? %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <% @users.each do |user| %>
                <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
                  <div class="relative flex-shrink-0">
                    <% if user.avatar.attached? %>
                      <%= image_tag user.avatar, class: "w-12 h-12 rounded-full object-cover" %>
                    <% else %>
                      <div class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold">
                        <%= (user.first_name.present? ? user.first_name.first : user.email).first(1).upcase %>
                      </div>
                    <% end %>
                    <span class="w-3 h-3 bg-green-500 rounded-full border-2 border-white absolute bottom-0 right-0"></span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <span class="font-medium text-gray-800 block truncate">
                      <%= user.first_name.present? ? "#{user.first_name} #{user.last_name}" : user.email.split('@').first %>
                    </span>
                    <span class="text-xs text-gray-500"><%= user.posts.count %> ta post</span>
                  </div>
                  <%= button_to conversations_path(user_id: user.id), method: :post, class: "p-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                    </svg>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-12 text-gray-500">
              <p>Boshqa foydalanuvchilar yo'q</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
