<% content_for(:header_title, "Profil") %>

<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <!-- Cover & Avatar -->
    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 h-40 relative">
      <div class="absolute -bottom-16 left-6">
        <div class="relative">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, class: "w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg" %>
          <% else %>
            <div class="w-32 h-32 rounded-full bg-gray-200 flex items-center justify-center text-4xl font-bold text-gray-500 border-4 border-white shadow-lg">
              <%= (@user.first_name.present? ? @user.first_name.first : @user.email).first(1).upcase %>
            </div>
          <% end %>
          
          <% if @user == current_user %>
            <label class="absolute bottom-0 right-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center cursor-pointer hover:bg-blue-700 transition shadow-lg border-2 border-white">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-white">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
              </svg>
              <%= form_with model: @user, url: profile_path, method: :patch, html: { class: "hidden" } do |f| %>
                <%= f.file_field :avatar, accept: "image/*", onchange: "this.form.submit()", id: "avatar_upload" %>
              <% end %>
            </label>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="pt-20 pb-6 px-6">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">
            <%= @user.first_name.present? ? "#{@user.first_name} #{@user.last_name}" : @user.email.split('@').first %>
          </h1>
          <p class="text-gray-500"><%= @user.email %></p>
          <% if @user.phone.present? %>
            <p class="text-sm text-gray-400 mt-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              <%= @user.phone %>
            </p>
          <% end %>
        </div>

        <% if @user == current_user %>
          <div class="flex gap-2">
            <%= link_to conversations_path, class: "flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              Xabarlar
            <% end %>
            <%= link_to new_post_path, class: "flex items-center gap-2 bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              Yangi Post
            <% end %>
          </div>
        <% else %>
          <%= link_to conversations_path(user_id: @user), method: :post, class: "flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
            Xabar yuborish
          <% end %>
        <% end %>
      </div>

      <% if @user.bio.present? %>
        <p class="text-gray-600 mb-6"><%= @user.bio %></p>
      <% end %>

      <p class="text-sm text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline-block mr-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
        </svg>
        <%= l(@user.created_at, format: :long) %> dan beri a'zo
      </p>
    </div>
  </div>

  <!-- Edit Profile Form -->
  <% if @user == current_user %>
    <div class="bg-white rounded-xl shadow-sm p-6 mt-6">
      <h2 class="text-lg font-bold text-gray-800 mb-6 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>
        Profilni tahrirlash
      </h2>

      <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
            <ul class="list-disc list-inside">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :first_name, "Ism", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.text_field :first_name, class: "w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "Ismingiz" %>
          </div>

          <div>
            <%= f.label :last_name, "Familiya", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.text_field :last_name, class: "w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "Familiyangiz" %>
          </div>

          <div>
            <%= f.label :phone, "Telefon raqam", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.text_field :phone, class: "w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "+998 XX XXX XX XX" %>
          </div>

          <div>
            <%= f.label :username, "Foydalanuvchi nomi", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.text_field :username, class: "w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "username" %>
          </div>

          <div class="md:col-span-2">
            <%= f.label :bio, "Bio", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.text_area :bio, rows: 3, class: "w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "O'zingiz haqingizda qisqacha yozing..." %>
          </div>
        </div>

        <div class="mt-6">
          <%= f.submit "Saqlash", class: "bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 cursor-pointer transition font-medium" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- User Posts -->
  <div class="mt-6">
    <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m5.231 13.481L15 17.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v16.5c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9zm3.75 11.625a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
      </svg>
      <%= @user.first_name.present? ? "#{@user.first_name} #{@user.last_name}" : @user.email.split('@').first %> ning postlari
      <span class="text-sm font-normal text-gray-500">(<%= @user.posts.count %> ta)</span>
    </h2>

    <% if @user.posts.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @user.posts.order(created_at: :desc).each do |post| %>
          <div class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition">
            <% if post.image.attached? %>
              <%= link_to post_path(post) do %>
                <div class="h-40 overflow-hidden">
                  <%= image_tag post.image, class: "w-full h-full object-cover" %>
                </div>
              <% end %>
            <% end %>
            
            <div class="p-4">
              <h3 class="font-bold text-gray-800 mb-2 line-clamp-1">
                <%= link_to post.title, post_path(post), class: "hover:text-blue-600" %>
              </h3>
              <p class="text-sm text-gray-600 mb-3 line-clamp-2"><%= truncate(post.content, length: 100) %></p>
              <div class="flex items-center justify-between text-xs text-gray-500">
                <span><%= time_ago_in_words(post.created_at) %> oldin</span>
                <span class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
                  </svg>
                  <%= post.comments.count %>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-xl shadow-sm p-12 text-center">
        <p class="text-gray-500">Hali postlar yo'q</p>
      </div>
    <% end %>
  </div>
</div>
