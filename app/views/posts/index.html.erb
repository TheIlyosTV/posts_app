<% content_for(:header_title, "Bosh sahifa") %>

<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Postlar</h1>

    <% if user_signed_in? %>
      <%= link_to new_post_path, class: "flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-lg hover:bg-blue-700 transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Yangi Post
      <% end %>
    <% end %>
  </div>

  <% if @posts.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @posts.each do |post| %>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition flex flex-col">
          <% if post.image.attached? %>
            <%= link_to post_path(post), class: "block" do %>
              <div class="h-48 overflow-hidden">
                <%= image_tag post.image, class: "w-full h-full object-cover" %>
              </div>
            <% end %>
          <% end %>
          
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center gap-3 mb-3">
              <%= link_to profile_path(id: post.user.id), class: "hover:opacity-80" do %>
                <% if post.user.avatar.attached? %>
                  <%= image_tag post.user.avatar, class: "w-10 h-10 rounded-full object-cover" %>
                <% else %>
                  <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-sm">
                    <%= (post.user.first_name.present? ? post.user.first_name.first : post.user.email).first(1).upcase %>
                  </div>
                <% end %>
              <% end %>
              <div>
                <%= link_to profile_path(id: post.user.id), class: "font-medium text-gray-800 hover:text-blue-600 text-sm" do %>
                  <%= post.user.first_name.present? ? "#{post.user.first_name} #{post.user.last_name}" : post.user.email.split('@').first %>
                <% end %>
                <p class="text-xs text-gray-500"><%= time_ago_in_words(post.created_at) %> oldin</p>
              </div>
            </div>
            
            <h2 class="text-lg font-bold text-gray-800 mb-2 line-clamp-2">
              <%= link_to post.title, post_path(post), class: "hover:text-blue-600" %>
            </h2>
            
            <p class="text-gray-600 text-sm mb-4 line-clamp-3 flex-1"><%= truncate(post.content, length: 120) %></p>
            
            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
              <div class="flex items-center gap-4 text-gray-500 text-sm">
                <span class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
                  </svg>
                  <%= post.comments.count %>
                </span>
              </div>
              
              <% if user_signed_in? && post.user == current_user %>
                <%= button_to post_path(post), method: :delete, 
                    data: { confirm: "Postni o'chirishni tasdiqlaysizmi?" },
                    class: "p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-sm p-12 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto text-gray-300 mb-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
      </svg>
      <p class="text-gray-500 mb-4">Hali postlar yo'q</p>
      <% if user_signed_in? %>
        <%= link_to "Birinchi postni yarating", new_post_path, class: "inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition" %>
      <% end %>
    </div>
  <% end %>
</div>
