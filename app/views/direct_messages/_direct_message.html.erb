<div class="flex <%= direct_message.user_id == user_id ? 'justify-end' : 'justify-start' %>">
  <div class="max-w-md <%= direct_message.user_id == user_id ? 'bg-blue-600 text-white' : 'bg-white text-gray-800' %> rounded-2xl px-4 py-2 shadow-sm">
    <p><%= direct_message.content %></p>
    <span class="text-xs <%= direct_message.user_id == user_id ? 'text-blue-100' : 'text-gray-400' %> block mt-1 text-right">
      <%= l(direct_message.created_at, format: :short) %>
    </span>
  </div>
</div>
