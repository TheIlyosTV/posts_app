<div class="mb-3 p-3 bg-white rounded-lg shadow-sm" data-controller="message">
  <div class="flex justify-between items-start">
    <span class="font-semibold text-blue-600"><%= message.user.username || message.user.email %></span>
    <span class="text-xs text-gray-400"><%= l(message.created_at, format: :short) %></span>
  </div>
  <p class="text-gray-700 mt-1"><%= message.content %></p>
</div>
